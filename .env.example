# Copy to .env.local for local work. NEVER commit real values; on Vercel they are set in Project Settings -> Environment Variables.
# Neon Postgres connection string (a NEW Neon project just for this app, not shared with other apps)
DATABASE_URL=
# GitHub OAuth app credentials (GitHub -> Settings -> Developer settings -> OAuth Apps)
GITHUB_ID=
GITHUB_SECRET=
# A long random string (for example: openssl rand -base64 32)
NEXTAUTH_SECRET=
# ADMINISTRATOR: only the GitHub account with this NUMERIC id gets the admin role (https://api.github.com/users/<your-username> -> "id")
OWNER_GITHUB_ID=
# Google OAuth client (Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# BUSINESS OWNER: the one Google account (verified email) that gets the business_owner role
BUSINESS_OWNER_GOOGLE_EMAIL=
# Local development only; ignored in production builds
# ADMIN_DEV_BYPASS=1
