# Copy to .env.local for local work. NEVER commit real values; on Vercel they are set in Project Settings -> Environment Variables.
# Neon Postgres connection string (a NEW Neon project just for this app, not shared with other apps)
DATABASE_URL=
# GitHub OAuth app credentials (GitHub -> Settings -> Developer settings -> OAuth Apps)
GITHUB_ID=
GITHUB_SECRET=
# A long random string (for example: openssl rand -base64 32)
NEXTAUTH_SECRET=
# Only the GitHub account with this NUMERIC id can sign in (https://api.github.com/users/<your-username> -> "id")
OWNER_GITHUB_ID=
# Local development only; ignored in production builds
# ADMIN_DEV_BYPASS=1
