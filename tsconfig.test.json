{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": "src/lib",
    "outDir": ".testbuild"
  },
  "include": [
    "src/lib/csv.ts",
    "src/lib/schema.ts",
    "src/lib/taxRules.ts",
    "src/lib/money.ts",
    "src/lib/dates.ts",
    "src/lib/income.ts",
    "src/lib/inventory.ts",
    "src/lib/squareFormat.ts",
    "src/lib/squareImport.ts",
    "src/lib/expenses.ts",
    "src/lib/mileage.ts",
    "src/lib/receipts.ts",
    "src/lib/lots.ts",
    "src/lib/taxforms.ts",
    "src/lib/packet.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
